@model List<Nota>
@{
    ViewData["Title"] = "Gestor de notas";
    var categorias = ViewBag.Categorias as List<string> ?? new List<string>();
    var q = ViewBag.Q as string;
    var categoriaActual = ViewBag.Categoria as string;
}

<div class="pagetitle">
    <h1>Gestor de notas</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active">Notas</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">

        <div class="col-lg-4">

            <div class="card">
                <div class="card-body pt-3">
                    <h5 class="card-title">Nueva nota</h5>

                    <form asp-action="Crear" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Titulo</label>
                            <input name="titulo" class="form-control" maxlength="100" required
                                   placeholder="Ej: Ideas para el proyecto" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Categoria</label>
                            <input name="categoria" class="form-control" maxlength="40" list="listaCategorias"
                                   placeholder="General" />
                            <datalist id="listaCategorias">
                                @foreach (var categoria in categorias)
                                {
                                    <option value="@categoria"></option>
                                }
                            </datalist>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Contenido</label>
                            <textarea name="contenido" class="form-control" rows="5" required
                                      placeholder="Escribe aqui tu nota..."></textarea>
                        </div>

                        <button class="btn btn-primary w-100" type="submit">
                            <i class="bi bi-journal-plus"></i> Guardar nota
                        </button>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-body pt-3">
                    <h5 class="card-title">Buscar</h5>
                    <form asp-action="Index" method="get">
                        <div class="mb-2">
                            <input name="q" class="form-control" value="@q" placeholder="Texto a buscar..." />
                        </div>
                        <div class="mb-2">
                            <select name="categoria" class="form-select">
                                <option value="">Todas las categorias</option>
                                @foreach (var categoria in categorias)
                                {
                                    <option value="@categoria" selected="@(categoriaActual == categoria)">@categoria</option>
                                }
                            </select>
                        </div>
                        <button class="btn btn-outline-primary w-100" type="submit">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </form>
                </div>
            </div>

        </div>

        <div class="col-lg-8">

            <div class="card">
                <div class="card-body pt-3">
                    <h5 class="card-title">Notas (@Model.Count)</h5>

                    @if (!Model.Any())
                    {
                        <p class="text-muted mb-0">No hay notas que coincidan con la busqueda.</p>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var nota in Model)
                            {
                                <div class="col-md-6">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start gap-2">
                                                <h6 class="mb-1">@nota.Titulo</h6>
                                                <span class="badge bg-secondary">@nota.Categoria</span>
                                            </div>
                                            <p class="small text-muted mb-2">
                                                Actualizada: @nota.ActualizadaEn.ToString("dd/MM/yyyy HH:mm")
                                            </p>
                                            <p class="mb-3" style="white-space: pre-line;">@nota.Contenido</p>
                                            <div class="d-flex gap-2">
                                                <a class="btn btn-sm btn-outline-primary"
                                                   asp-action="Editar" asp-route-id="@nota.Id">
                                                    <i class="bi bi-pencil"></i> Editar
                                                </a>
                                                <form asp-action="Eliminar" method="post" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@nota.Id" />
                                                    <button class="btn btn-sm btn-outline-danger" type="submit">
                                                        <i class="bi bi-trash"></i> Eliminar
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>

    </div>
</section>
