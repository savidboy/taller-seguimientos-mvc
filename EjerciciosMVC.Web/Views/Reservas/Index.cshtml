@model ReservasViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Sistema de reservas";
    var cop = new CultureInfo("es-CO");
    Func<int, string> nombreServicio = id =>
        Model.Servicios.FirstOrDefault(s => s.Id == id)?.Nombre ?? "Servicio";
    Func<int, decimal> precioServicio = id =>
        Model.Servicios.FirstOrDefault(s => s.Id == id)?.Precio ?? 0m;
    var fechaTexto = Model.Fecha.ToString("yyyy-MM-dd");
}

<div class="pagetitle">
    <h1>Sistema de reservas</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active">Reservas</li>
        </ol>
    </nav>
</div>

<section class="section">

    <div class="card">
        <div class="card-body pt-3">
            <h5 class="card-title">Consulta la disponibilidad</h5>

            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label">Servicio</label>
                    <select name="servicioId" class="form-select">
                        @foreach (var servicio in Model.Servicios)
                        {
                            <option value="@servicio.Id" selected="@(Model.ServicioSeleccionado?.Id == servicio.Id)">
                                @servicio.Nombre - $@servicio.Precio.ToString("N0", cop) (@servicio.DuracionMin min)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fecha</label>
                    <input name="fecha" type="date" class="form-control" value="@fechaTexto" />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary w-100" type="submit">
                        <i class="bi bi-search"></i> Ver horarios
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="row">

        <div class="col-lg-5">

            <div class="card">
                <div class="card-body pt-3">
                    <h5 class="card-title">Nueva reserva</h5>

                    <p class="small text-muted mb-3">
                        <i class="bi bi-scissors"></i>
                        <strong>@Model.ServicioSeleccionado?.Nombre</strong> &middot;
                        $@((Model.ServicioSeleccionado?.Precio ?? 0m).ToString("N0", cop)) &middot;
                        @(Model.ServicioSeleccionado?.DuracionMin ?? 0) minutos
                    </p>

                    <form asp-action="Reservar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="servicioId" value="@Model.ServicioSeleccionado?.Id" />
                        <input type="hidden" name="fecha" value="@fechaTexto" />

                        <div class="mb-3">
                            <label class="form-label">Nombre del cliente</label>
                            <input name="cliente" class="form-control" maxlength="80" required
                                   placeholder="Ej: Camila Torres" />
                        </div>

                        <label class="form-label">Horario disponible</label>
                        <div class="row g-2 mb-3">
                            @foreach (var hora in Model.Horas)
                            {
                                var ocupada = Model.Ocupadas.Contains(hora);
                                var idHora = "hora-" + hora.Replace(":", string.Empty);
                                <div class="col-4">
                                    <input type="radio" class="btn-check" name="hora" id="@idHora"
                                           value="@hora" disabled="@ocupada" required />
                                    <label class="btn btn-sm btn-outline-primary w-100 @(ocupada ? "disabled" : "")"
                                           for="@idHora">
                                        @hora
                                    </label>
                                </div>
                            }
                        </div>

                        <button class="btn btn-primary w-100" type="submit">
                            <i class="bi bi-calendar-plus"></i> Reservar
                        </button>
                    </form>
                </div>
            </div>

        </div>

        <div class="col-lg-7">

            <div class="card">
                <div class="card-body pt-3">
                    <h5 class="card-title">Reservas del @Model.Fecha.ToString("dd/MM/yyyy")</h5>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Hora</th>
                                    <th>Cliente</th>
                                    <th>Servicio</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Reservas.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            No hay reservas para este dia.
                                        </td>
                                    </tr>
                                }
                                @foreach (var reserva in Model.Reservas)
                                {
                                    <tr>
                                        <td class="fw-semibold">@reserva.Hora</td>
                                        <td>@reserva.Cliente</td>
                                        <td class="small">
                                            @nombreServicio(reserva.ServicioId)
                                            <span class="text-muted d-block">$@precioServicio(reserva.ServicioId).ToString("N0", cop)</span>
                                        </td>
                                        <td>
                                            @if (reserva.Confirmada)
                                            {
                                                <span class="badge bg-success">Confirmada</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Pendiente</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-1">
                                                @if (!reserva.Confirmada)
                                                {
                                                    <form asp-action="Confirmar" method="post" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@reserva.Id" />
                                                        <input type="hidden" name="servicioId" value="@Model.ServicioSeleccionado?.Id" />
                                                        <input type="hidden" name="fecha" value="@fechaTexto" />
                                                        <button class="btn btn-sm btn-outline-success" type="submit" title="Confirmar">
                                                            <i class="bi bi-check-lg"></i>
                                                        </button>
                                                    </form>
                                                }
                                                <form asp-action="Cancelar" method="post" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@reserva.Id" />
                                                    <input type="hidden" name="servicioId" value="@Model.ServicioSeleccionado?.Id" />
                                                    <input type="hidden" name="fecha" value="@fechaTexto" />
                                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="Cancelar">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>

    </div>
</section>
