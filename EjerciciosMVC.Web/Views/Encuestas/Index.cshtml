@model List<Encuesta>
@{
    ViewData["Title"] = "Plataforma de encuestas";
}

<div class="pagetitle">
    <h1>Plataforma de encuestas</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active">Encuestas</li>
        </ol>
    </nav>
</div>

<section class="section">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-muted mb-0">Vota en una encuesta o crea la tuya propia.</p>
        <a class="btn btn-primary btn-sm" asp-action="Crear">
            <i class="bi bi-plus-lg"></i> Nueva encuesta
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body pt-3">
                <p class="text-muted mb-0">Todavia no hay encuestas. Crea la primera.</p>
            </div>
        </div>
    }

    <div class="row">
        @foreach (var encuesta in Model)
        {
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-body pt-3 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                            <h5 class="card-title mb-0">@encuesta.Pregunta</h5>
                            <span class="badge bg-secondary">@encuesta.TotalVotos votos</span>
                        </div>

                        <form asp-action="Votar" method="post" class="mt-auto">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="encuestaId" value="@encuesta.Id" />

                            @foreach (var opcion in encuesta.Opciones)
                            {
                                var idOpcion = "opcion-" + encuesta.Id + "-" + opcion.Id;
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="opcionId"
                                           id="@idOpcion" value="@opcion.Id" required />
                                    <label class="form-check-label" for="@idOpcion">@opcion.Texto</label>
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <a class="small" asp-action="Resultados" asp-route-id="@encuesta.Id">
                                    Ver resultados
                                </a>
                                <button class="btn btn-sm btn-primary" type="submit">
                                    <i class="bi bi-check2-circle"></i> Votar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

</section>
