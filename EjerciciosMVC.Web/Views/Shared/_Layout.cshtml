@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string Activo(string nombre) =>
        controlador.Equals(nombre, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ejercicios MVC</title>
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/assets/css/style.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <header id="header" class="header fixed-top d-flex align-items-center">
        <div class="d-flex align-items-center justify-content-between">
            <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center">
                <i class="bi bi-mortarboard"></i>
                <span class="d-none d-lg-block">Ejercicios MVC</span>
            </a>
            <i class="bi bi-list toggle-sidebar-btn"></i>
        </div>
    </header>

    <aside id="sidebar" class="sidebar">
        <ul class="sidebar-nav" id="sidebar-nav">

            <li class="nav-item">
                <a class="@Activo("Home")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid"></i><span>Inicio</span>
                </a>
            </li>

            <li class="nav-heading">Ejercicios</li>

            <li class="nav-item">
                <a class="@Activo("Tareas")" asp-controller="Tareas" asp-action="Index">
                    <i class="bi bi-check2-square"></i><span>1. Lista de tareas</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="@Activo("Propinas")" asp-controller="Propinas" asp-action="Index">
                    <i class="bi bi-calculator"></i><span>2. Calculadora de propinas</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="@Activo("Contrasenas")" asp-controller="Contrasenas" asp-action="Index">
                    <i class="bi bi-shield-lock"></i><span>3. Contrasenas seguras</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="@Activo("Gastos")" asp-controller="Gastos" asp-action="Index">
                    <i class="bi bi-wallet2"></i><span>4. Gestor de gastos</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="@Activo("Reservas")" asp-controller="Reservas" asp-action="Index">
                    <i class="bi bi-calendar-check"></i><span>5. Sistema de reservas</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="@Activo("Notas")" asp-controller="Notas" asp-action="Index">
                    <i class="bi bi-journal-text"></i><span>6. Gestor de notas</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="@Activo("Calendario")" asp-controller="Calendario" asp-action="Index">
                    <i class="bi bi-calendar3"></i><span>7. Calendario de eventos</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="@Activo("Recetas")" asp-controller="Recetas" asp-action="Index">
                    <i class="bi bi-egg-fried"></i><span>8. Recetas</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="@Activo("Memoria")" asp-controller="Memoria" asp-action="Index">
                    <i class="bi bi-grid-3x3-gap"></i><span>9. Juego de memoria</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="@Activo("Encuestas")" asp-controller="Encuestas" asp-action="Index">
                    <i class="bi bi-bar-chart"></i><span>10. Encuestas</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="@Activo("Cronometro")" asp-controller="Cronometro" asp-action="Index">
                    <i class="bi bi-stopwatch"></i><span>11. Cronometro online</span>
                </a>
            </li>

        </ul>
    </aside>

    <main id="main" class="main">

        @if (TempData["Ok"] is string ok)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-1"></i> @ok
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-1"></i> @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        @RenderBody()

    </main>

    <footer id="footer" class="footer">
        <div class="copyright">
            Ejercicios de arquitectura MVC &copy; @DateTime.Now.Year
        </div>
    </footer>

    <a href="#" class="back-to-top d-flex align-items-center justify-content-center">
        <i class="bi bi-arrow-up-short"></i>
    </a>

    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
