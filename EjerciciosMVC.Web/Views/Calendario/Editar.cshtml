@model Evento
@{
    ViewData["Title"] = "Editar evento";
    var fecha = Model.Fecha == default ? DateTime.Today : Model.Fecha;
}

<div class="pagetitle">
    <h1>Editar evento</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Calendario</a></li>
            <li class="breadcrumb-item active">Editar</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-7">

            <div class="card">
                <div class="card-body pt-3">
                    <h5 class="card-title">Datos del evento</h5>

                    <form asp-action="Editar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label">Titulo</label>
                            <input name="Titulo" class="form-control" maxlength="100" required value="@Model.Titulo" />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-7">
                                <label class="form-label">Fecha</label>
                                <input name="Fecha" type="date" class="form-control"
                                       value="@fecha.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-5">
                                <label class="form-label">Hora</label>
                                <input name="Hora" type="time" class="form-control" value="@Model.Hora" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Recordatorio</label>
                            <select name="RecordatorioMin" class="form-select">
                                <option value="0" selected="@(Model.RecordatorioMin == 0)">Sin recordatorio</option>
                                <option value="15" selected="@(Model.RecordatorioMin == 15)">15 minutos antes</option>
                                <option value="30" selected="@(Model.RecordatorioMin == 30)">30 minutos antes</option>
                                <option value="60" selected="@(Model.RecordatorioMin == 60)">1 hora antes</option>
                                <option value="1440" selected="@(Model.RecordatorioMin == 1440)">1 dia antes</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descripcion</label>
                            <textarea name="Descripcion" class="form-control" rows="4">@Model.Descripcion</textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-save"></i> Guardar cambios
                            </button>
                            <a class="btn btn-outline-secondary"
                               asp-action="Index"
                               asp-route-mes="@fecha.Month"
                               asp-route-anio="@fecha.Year">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</section>
